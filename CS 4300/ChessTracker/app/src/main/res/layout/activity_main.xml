<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/chess_light">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/turnText"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:text="@string/turn_text"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Spinner
        android:id="@+id/openingSpinner"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/turnText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/moveList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/move_green"
        app:layout_constraintTop_toBottomOf="@id/openingSpinner"
        app:layout_constraintBottom_toTopOf="@id/moveInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/moveInput"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="@string/move_hint"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/moveList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/addMoveBtn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/add_move"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/accent_blue"
        android:textColor="@color/text_light"
        app:layout_constraintTop_toBottomOf="@id/moveInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/resetBtn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/reset_game"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/accent_blue"
        android:textColor="@color/text_light"
        app:layout_constraintTop_toBottomOf="@id/addMoveBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>