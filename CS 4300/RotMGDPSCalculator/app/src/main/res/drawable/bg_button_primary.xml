<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/highlight_dark_pastel_purple" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="@color/highlight_dark_pastel_purple" android:endColor="@color/rotmg_primary_dark" />
            <stroke android:width="1dp" android:color="@color/rotmg_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
