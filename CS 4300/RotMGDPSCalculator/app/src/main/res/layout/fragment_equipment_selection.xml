<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtEquipmentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/equipment_selection"
        android:textColor="@color/highlight_dark_pastel_purple"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtWeaponLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/weapon"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="15sp" />

    <Spinner
        android:id="@+id/spinnerWeapon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtAbilityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ability"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="15sp" />

    <Spinner
        android:id="@+id/spinnerAbility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtArmorLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/armor"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="15sp" />

    <Spinner
        android:id="@+id/spinnerArmor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtRingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ring"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="15sp" />

    <Spinner
        android:id="@+id/spinnerRing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtPreviewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/available_equipment_preview"
        android:textColor="@color/highlight_gray"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEquipment"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_recycler_panel"
        android:clipToPadding="false"
        android:padding="8dp" />

</LinearLayout>
