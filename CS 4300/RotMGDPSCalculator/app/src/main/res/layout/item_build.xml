<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_gray"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/txtBuildClass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Class:"
        android:textColor="@color/highlight_forest_green"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtBuildWeapon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Weapon:"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtBuildAbility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ability:"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtBuildArmor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Armor:"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtBuildRing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ring:"
        android:textColor="@color/rotmg_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtBuildDps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="DPS:"
        android:textColor="@color/highlight_red"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
